    @BuryingLog(apiUrl = "#{url}")
    public String post(String url, String parameterString) {
        Map<String, String> headers = new HashMap<>(8);
        headers.put("Content-Type", "application/json;charset=utf-8");
        headers.put("Accept", "application/json");
        headers.put("Trace-ID", InjectVariable.getRequestId());
        String userSessionId = InjectVariable.getUserSessionId();
        if (SpringProfileUtils.devProfile() && needDevSession(url)) userSessionId = "d811d590f72541de8308131e3ccb7a39";
        headers.put("wind.sessionid", userSessionId);
        StopWatch stopWatch = StopWatch.create(IdUtil.randomUUID());
        stopWatch.start();
        try {
            log.info("http post request {}, parameter {}, header {}", url, parameterString.substring(0, Math.min(parameterString.length(), 1000)), headers.toString());
            HttpResponse execute = HttpUtil.createPost(url).setReadTimeout(600000).headerMap(headers, true).body(parameterString).timeout(TIME_OUT).execute();
            String body = execute.body();
            log.info("http post response {}, result {}", url, body.substring(0, Math.min(body.length(), 1000)));
            return body;
        } catch (Exception e) {
            throw new HttpServerException(e.getMessage(), e);
        } finally {
            stopWatch.stop();
            long millis = stopWatch.getLastTaskTimeMillis();
            if (millis > TimeUnit.SECONDS.toMillis(1)) {
                log.warn("Http {} cost {} ms.", url, millis);
            }
        }
    }

    @BuryingLog(apiUrl = "#{url}")
    public String postV2(String url, String parameterString) {
        int readTimeOut = config.getIntProperty("http.read.timeout", 200000);
        int connectionTimeOut = config.getIntProperty("http.connection.timeout", 5000);
        long now = System.currentTimeMillis();
        Map<String, String> headers = new HashMap<>(8);
        headers.put("Content-Type", "application/json;charset=utf-8");
        headers.put("Accept", "application/json");
        headers.put("X-App-id", "Wind.Stock.AIresearch.Framework");
        headers.put("Trace-ID", UUID.randomUUID().toString().replace("-", ""));
        headers.put("trace_src", "Wind.Stock.AIresearch.Framework");
        headers.put("trace_id", UUID.randomUUID().toString().replace("-", ""));
        headers.put("X-Routing-Key", config.getProperty("parse.chunks.routing-key", "10.24.12.39"));
        headers.put("X-User-Id", InjectVariable.getUserId());
        String userSessionId = InjectVariable.getUserSessionId();
        if (SpringProfileUtils.devProfile() && needDevSession(url)) userSessionId = "d811d590f72541de8308131e3ccb7a39";
        headers.put("wind.sessionid", userSessionId);
        StopWatch stopWatch = StopWatch.create(IdUtil.randomUUID());
        stopWatch.start();
        try {
            if (parameterString != null) {
                log.info("http post request {}, parameter {}, header {}", url, parameterString.substring(0, Math.min(parameterString.length(), 1000)), headers.toString());
            }
            HttpResponse execute = HttpUtil.createPost(url)
                    .setReadTimeout(readTimeOut)
                    .setConnectionTimeout(connectionTimeOut)
                    .timeout(60000) // 统一设置超时时间（包括写入）
                    .headerMap(headers, true)
                    .body(parameterString)
                    .execute();
            String body = execute.body();
            log.info("http post response {}, result {} {} {}", url, body.substring(0, Math.min(body.length(), 1000)), System.currentTimeMillis() - now, execute.getStatus());
            return body;
        } catch (Exception e) {
            throw new HttpServerException(e.getMessage(), e);
        } finally {
            stopWatch.stop();
            long millis = stopWatch.getLastTaskTimeMillis();
            if (millis > TimeUnit.SECONDS.toMillis(1)) {
                log.warn("Http {} cost {} ms.", url, millis);
            }
        }
    }

