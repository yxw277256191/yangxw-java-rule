        try {
            OkHttpClient client = new OkHttpClient.Builder()
                    .connectTimeout(60, TimeUnit.SECONDS)
                    .writeTimeout(60, TimeUnit.SECONDS)
                    .readTimeout(60, TimeUnit.SECONDS)
                    .build();
            MediaType mediaType = MediaType.parse("application/json");
            RequestBody body = RequestBody.create(mediaType, paramString);
            Request okRequest = new Request.Builder()
                    .url(url)
                    .post(body)
                    .addHeader("Content-Type", "application/json")
                    .addHeader(WindConstants.SESSION_ID, InjectVariable.getUserSessionId())
                    .build();
            response = client.newCall(okRequest).execute();
            log.info("getAliceStreamResponse#getResponse result={}", response);
        } catch (IOException e) {
            String errMsg = ExceptionUtils.stacktraceToString(e, 8);
            log.error("canot acquire ext/event-stream response err:{}", errMsg);
            throw new AliceProcessException("canot acquire ext/event-stream response errMsg:" + errMsg, null);
        }
        return response;
    }

