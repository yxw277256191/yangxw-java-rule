    @BuryingLog(apiUrl = "#{url}")
    public void postTimeOut(List<String> resultTxtList, String url, String parameterString, String reidskey, String timeout) {
        Map<String, String> headers = new HashMap<>(8);
        headers.put("Content-Type", "application/json;charset=utf-8");
        headers.put("Accept", "application/json");
        headers.put("Trace-ID", InjectVariable.getRequestId());
        String userSessionId = InjectVariable.getUserSessionId();
        if (SpringProfileUtils.devProfile() && needDevSession(url)) userSessionId = "d811d590f72541de8308131e3ccb7a39";
        headers.put("wind.sessionid", userSessionId);
        try {
            log.info("http postTimeOutt request {}, parameter {}, header {}", url, parameterString, headers);
            HttpResponse execute = HttpUtil.createPost(url).setReadTimeout(Integer.valueOf(timeout)).headerMap(headers, true).body(parameterString).timeout(Integer.valueOf(timeout)).execute();
            String body = execute.body();
            log.info("http postTimeOutt response {}, result {}", url, body.substring(0, Math.min(body.length(), 1000)));

            JSONObject responseJson = JSONObject.parseObject(body);
            //String answer = responseJson.getJSONObject("body").getJSONArray("choices").getJSONObject(0).getJSONObject("message").getString("content");
            String answer = "";
            JSONArray choicesArray = responseJson.getJSONObject("body").getJSONArray("choices");
            if (choicesArray != null && choicesArray.size() > 0) {
                answer = choicesArray.getJSONObject(0).getJSONObject("message").getString("content");
            }

            //start 如果answer为空，则格式问题，用新格式匹配
            if (StrUtil.isEmpty(answer)) {
                HttpAnswerResponse responseBean = JSONObject.parseObject(responseJson.toString(), HttpAnswerResponse.class);
                HttpAnswerResponse.Body.Content[] content = responseBean.getBody().getContent();
                if (content.length > 0) {
                    answer = content[0].getText();
                }
            }
            //end

            if (StringUtils.isNotEmpty(answer)) {
                resultTxtList.add(answer);
                if (StringUtils.isNotEmpty(reidskey)) {
                    log.info("异步请求 post Reidskey:{}", reidskey);
                    redisManager.set(reidskey, answer, REDIS_TTL);
                }
            }
        } catch (Exception e) {
            throw new HttpServerException(e.getMessage(), e);
        }
    }

