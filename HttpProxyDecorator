    @BuryingLog(apiUrl = "#{url}")
    public String generalAigc(String url, String param) {
        StringBuilder answer = new StringBuilder();
        Response response = null;
        try {
            OkHttpClient client = new OkHttpClient.Builder()
                    .connectTimeout(60, TimeUnit.SECONDS)
                    .writeTimeout(60, TimeUnit.SECONDS)
                    .readTimeout(60, TimeUnit.SECONDS)
                    .build();
            MediaType mediaType = MediaType.parse("application/json");
            RequestBody body = RequestBody.create(mediaType, param);
            Request okRequest = new Request.Builder()
                    .url(url)
                    .post(body)
                    .addHeader("Content-Type", "application/json")
                    .addHeader(WindConstants.SESSION_ID, InjectVariable.getUserSessionId())
                    .build();
            response = client.newCall(okRequest).execute();
            log.info("getAliceStreamResponse#getResponse result={}", response);
            String line = null;
            while ((line = Objects.requireNonNull(response.body()).source().readUtf8Line()) != null) {
                if (line.equals("data: [DONE]") || line.contains("[DONE]")) {
                    break;
                } else if (line.startsWith("data:")) {
                    String dataStr = line.substring("data:".length()).trim();
                    JSONObject responseJson;
                    try {
                        responseJson = JSONObject.parseObject(dataStr);
                        String content = responseJson
                                .getJSONArray("choices")
                                .getJSONObject(0)
                                .getJSONObject("delta")
                                .getString("content");
                        if (StrUtil.isNotEmpty(content)) {
                            answer.append(content);
                        }
                    } catch (Exception e) {
                        log.error("alice response extract err, origin content: {} errMsg:{}",
                                line, ExceptionUtils.stacktraceToString(e, 8));
                    }
                }
            }
            return answer.toString();
        } catch (IOException e) {
            String errMsg = ExceptionUtils.stacktraceToString(e, 8);
            log.error("canot acquire ext/event-stream response err:{}", errMsg);
            throw new AliceProcessException("canot acquire ext/event-stream response errMsg:" + errMsg, null);
        } finally {
            try {
                response.close();
            } catch (Exception e) {

            }
        }
    }


