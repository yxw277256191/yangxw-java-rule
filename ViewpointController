package cn.com.wind.stock.doc.controller;

import cn.com.wind.stock.common.base.HttpResult;
import cn.com.wind.stock.doc.bean.request.AiResearchRequest;
import cn.com.wind.stock.doc.cloud.model.CommandInfoModel;
import cn.com.wind.stock.doc.cloud.model.InvestmentRatingModel;
import cn.com.wind.stock.doc.cloud.model.OneCompareForecastResponse;
import cn.com.wind.stock.doc.service.QuestionService;
import cn.com.wind.stock.doc.service.ViewpointService;
import cn.com.wind.stock.pdf.pdf.alice.bean.AiResearchBean;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import lombok.extern.slf4j.Slf4j;
import org.apache.commons.lang3.StringUtils;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.List;
import java.util.Map;

/**
 * 观点坐标系，观点博弈
 *
 * @author yangxw
 * @data 2026/01/06
 */
@Tag(name = "观点坐标系，观点博弈")
@RequestMapping("/SmartReaderChatService")
@RestController
@Slf4j
public class ViewpointController {

    @Autowired
    private QuestionService questionService;
    @Autowired
    private ViewpointService viewpointService;

    @Operation(summary = "F9测试接口")
    @PostMapping("/viewpoint/getF9")
    public HttpResult getF9(@RequestBody CommandInfoModel model) {
        String result = viewpointService.getF9(model);
        return HttpResult.ok(result);
    }

    @Operation(summary = "F9-盈利预测-全市场一致预测与明细分布")
    @PostMapping("/viewpoint/oneCompareForecast")
    public HttpResult oneCompareForecast(@RequestBody CommandInfoModel request) {
        // 1. 参数校验
        if (StringUtils.isBlank(request.getWindCode()) || StringUtils.isBlank(request.getStartDate()) || StringUtils.isBlank(request.getEndDate()) || StringUtils.isBlank(request.getStyle())) {
            return HttpResult.fail(301, "请求参数错误!");
        }
        List<OneCompareForecastResponse> result = viewpointService.oneCompareForecast(request);
        return HttpResult.ok(result);
    }

    @Operation(summary = "F9-盈利预测-预测净利润-提示词")
    @PostMapping("/viewpoint/forecastNetProfit")
    public HttpResult forecastNetProfit(@RequestBody CommandInfoModel request) {
        // 1. 参数校验
        if (StringUtils.isBlank(request.getWindCode()) || StringUtils.isBlank(request.getEndDate())
                || StringUtils.isBlank(request.getYear()) || request.getResearchDetailValue1() == null) {
            return HttpResult.fail(301, "预测净利润-请求参数错误!");
        }
        Map<String, Object> result = viewpointService.forecastNetProfit(request);
        return HttpResult.ok(result);
    }

    @Operation(summary = "观点坐标系-查询")
    @PostMapping("/viewpoint/coordinates")
    public HttpResult coordinates(@RequestBody AiResearchRequest request) {
        // 1. 参数校验
        if (StringUtils.isBlank(request.getWindCode()) || StringUtils.isBlank(request.getEndDate())) {
            return HttpResult.fail(301, "观点坐标系-查询 参数错误!");
        }
        Map<String, Object> result = viewpointService.coordinates(request);
        return HttpResult.ok(result);
    }

    @Operation(summary = "机构评级变动-查询")
    @PostMapping("/viewpoint/ratingChange")
    public HttpResult ratingChange(@RequestBody CommandInfoModel request) {
        // 1. 参数校验
        if (StringUtils.isBlank(request.getWindCode()) || StringUtils.isBlank(request.getEndDate())) {
            return HttpResult.fail(301, "机构评级变动-查询 参数错误!");
        }
        Map<String, Object> result = viewpointService.ratingChange(request);
        return HttpResult.ok(result);
    }

    @Operation(summary = "投资评级-重要指标预测一览（2026E）-查询")
    @PostMapping("/viewpoint/investmentRating")
    public HttpResult investmentRating(@RequestBody CommandInfoModel request) {
        // 1. 参数校验
        if (StringUtils.isBlank(request.getWindCode())) {
            return HttpResult.fail(301, "投资评级-查询 参数错误!");
        }
        Map<String, Object> result = viewpointService.investmentRating(request);
        return HttpResult.ok(result);
    }



    //--------------------------------观点快照-------------------------------------------

    //非共识观点
    @Operation(summary = "观点快照：非共识观点-查询")
    @PostMapping("/viewpoint/nonConsensusViews")
    public HttpResult nonConsensusViews(@RequestBody CommandInfoModel request) {
        // 1. 参数校验
        if (StringUtils.isBlank(request.getWindCode())) {
            return HttpResult.fail(301, "观点快照：非共识观点-查询 参数错误!");
        }
        Map<String, Object> result = viewpointService.nonConsensusViews(request);
        return HttpResult.ok(result);
    }

    //市场共识
    @Operation(summary = "观点快照：市场共识-查询")
    @PostMapping("/viewpoint/consensusViews")
    public HttpResult consensusViews(@RequestBody CommandInfoModel request) {
        // 1. 参数校验
        if (StringUtils.isBlank(request.getWindCode())) {
            return HttpResult.fail(301, "观点快照：非共识观点-查询 参数错误!");
        }
        Map<String, Object> result = viewpointService.consensusViews(request);
        return HttpResult.ok(result);
    }

    //全市场一致投资预期
    @Operation(summary = "观点快照：全市场一致投资预期-查询")
    @PostMapping("/viewpoint/investmentOutlook")
    public HttpResult investmentOutlook(@RequestBody CommandInfoModel request) {
        // 1. 参数校验
        if (StringUtils.isBlank(request.getWindCode())) {
            return HttpResult.fail(301, "观点快照：全市场一致投资预期-查询 参数错误!");
        }
        Map<String, Object> result = viewpointService.investmentOutlook(request);
        return HttpResult.ok(result);
    }

}
