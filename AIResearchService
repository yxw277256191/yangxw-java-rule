     */
    public String betweenTreeNoStream(AiHangTreeRequest request) {
        //第二步：框架A+实体事件=聚合中间结果1--aigc
        if (StringUtils.isEmpty(request.getWindCode())) {
            return "";
        }
        request.setNodeType(StringUtils.isEmpty(request.getNodeType()) ? Constants.NodeType.FIVE : request.getNodeType());

        //获取框架信息
        AiGcPreprocRequest request1 = new AiGcPreprocRequest();
        request1.setWindCode(request.getWindCode());
        request1.setNodeType(Constants.NodeType.ONE);
        request1.setPromptId(Constants.PromptId.PromptId_1_P042256);
        List<AiGcPreprocEntity> list = mongoDBService.findMongoPreprocList(request1);
        if (CollectionUtils.isEmpty(list)) {
            return "";
        }
        //list.sort(Comparator.comparing(o -> o.getNodeOrder()));
        StringBuffer buffer = new StringBuffer();
        int re = 0;
        for (int i = 0; i < list.size(); i++) {
            AiGcPreprocEntity entity = list.get(i);
            if (entity.getNodeLevel() <= 1) {
                buffer.append("\n").append(entity.getNodeText()).append("\n");
            } else {
                buffer.append(entity.getNodeText()).append("\n");
                Optional<AiGcPreprocEntity> childList = list.stream().filter(item -> item.getNodePId().equals(entity.getNodeId())).findFirst();
                if (!childList.isPresent()) {
                    //末端加 Reference
                    re++;
                    int count = 0;
                    if (entity.getNodeLevel() == 2) {
                        count = 2;
                    } else if (entity.getNodeLevel() == 3) {
                        count = 4;
                    } else if (entity.getNodeLevel() == 4) {
                        count = 6;
                    } else if (entity.getNodeLevel() == 5) {
                        count = 8;
                    } else if (entity.getNodeLevel() == 6) {
                        count = 10;
                    }
                    String space = StrUtils.getSpaceByCount(" ", count);
                    buffer.append(space + "- Reference" + re).append("\n");
                }
            }
        }

        //框架A
        String frameworkText = buffer.toString();
        request.setFrameworkText(frameworkText);

        //获实体事件信息/获取指标信息
        AiGcPreprocRequest request2 = new AiGcPreprocRequest();
        request2.setWindCode(request.getWindCode());
        if (request.getNodeType().equals(Constants.NodeType.FIVE)) {
            //实体事件
            request2.setNodeType(Constants.NodeType.TWO);
            request2.setPromptId(Constants.PromptId.PromptId_2_P042254);
        } else if (request.getNodeType().equals(Constants.NodeType.SIX)) {
            //指标
            request2.setNodeType(Constants.NodeType.FOUR);
            request2.setPromptId(Constants.PromptId.PromptId_4_P050620);
        }
        String breakDownText = mongoDBService.findMongoPreproc(request2);
        if (StringUtils.isEmpty(breakDownText)) {
            return "";
        }

        //实体事件
        request.setBreakDownText(breakDownText);

        // 排序
        List<DocListBean> sortedList = list.get(0).getDocListBean().stream().filter(bean -> bean.getFrameworkDocId() != null).sorted(Comparator.comparing(DocListBean::getFrameworkDocId)).collect(Collectors.toList());
        // 排序
        String md5 = MD5Util.encrypt32(JSON.toJSONString(sortedList));
        AiGcPreprocRequest yzRequest = new AiGcPreprocRequest();
        yzRequest.setMd5(md5);
        yzRequest.setWindCode(request.getWindCode());
        yzRequest.setNodeType(request.getNodeType());
        String answerMG = this.getHangTreeText(yzRequest);
        if (StringUtils.isNotEmpty(answerMG)) {
            //return answerMG;
        }

        //聚合
        String contentText = request.getFrameworkText() + "/n/n" + request.getBreakDownText();
        //"P051132";
        request.setPromptId(StringUtils.isEmpty(request.getPromptId()) ? Constants.PromptId.PromptId_5_P051132 : request.getPromptId());
        String promptId = request.getPromptId();
        String companyName = request.getCompanyName();

        HashMap promptParams = new HashMap();
        if (companyName != null) {
            promptParams.put("companyName", companyName);
        }
        if (contentText != null) {
            promptParams.put("content", contentText);
        }
        String answer = aliceAigcAnswerHttpClient.pmpAigcNoStreamNew(promptParams, promptId);

        if (StringUtils.isNotEmpty(answer)) {
            AiGcPreprocRequest preprocRequest = new AiGcPreprocRequest();
            preprocRequest.setWindCode(request.getWindCode());
            preprocRequest.setNodeType(request.getNodeType());
            preprocRequest.setPromptId(promptId);
            preprocRequest.setDocListBean(sortedList);
            preprocRequest.setText(answer);
            preprocRequest.setMd5(md5);
            this.saveHangTree(preprocRequest);
        }
        return answer;
    }

    /**
     * 第四步 Reference拼接（框架A+（结果1+结果2））
     *
     * @param request
     * @return
     */
    public String betweenTreeAppend(AiHangTreeRequest request) {
        if (StringUtils.isEmpty(request.getWindCode())) {
            return "";
        }
        request.setNodeType(StringUtils.isEmpty(request.getNodeType()) ? Constants.NodeType.FIVE : request.getNodeType());

        //框架A
        AiGcPreprocRequest request1 = new AiGcPreprocRequest();
        request1.setWindCode(request.getWindCode());
        request1.setNodeType(Constants.NodeType.ONE);
        request1.setPromptId(Constants.PromptId.PromptId_1_P042256);
        List<AiGcPreprocEntity> frameworkTextList = this.getAiGcPreList(request1);
        if (CollectionUtils.isEmpty(frameworkTextList)) {
            return "";
        }

        //获实体事件信息
        AiGcPreprocRequest request2 = new AiGcPreprocRequest();
        request2.setWindCode(request.getWindCode());
        //实体事件
        request2.setNodeType(Constants.NodeType.FIVE);
        request2.setPromptId(Constants.PromptId.PromptId_5_P051132);
        List<AiGcPreprocEntity> breakDownTextList2 = mongoDBService.findMongoPreprocList(request2);
        if (CollectionUtils.isEmpty(breakDownTextList2)) {
            return "";
        }

        //获取指标信息
        AiGcPreprocRequest request3 = new AiGcPreprocRequest();
        request3.setWindCode(request.getWindCode());
        //指标
        request3.setNodeType(Constants.NodeType.SIX);
        request3.setPromptId(Constants.PromptId.PromptId_6_P051133);
        List<AiGcPreprocEntity> breakDownTextList3 = mongoDBService.findMongoPreprocList(request3);
        if (CollectionUtils.isEmpty(breakDownTextList3)) {
            return "";
        }

        //实体事件
        Map<String, String> result2 = new HashMap<>();
        for (AiGcPreprocEntity item : breakDownTextList2) {
            if (item.getNodeText().contains("Reference")) {
                int start = item.getNodeText().indexOf("：");
                String startText = item.getNodeText().substring(0, start).replace("*", "");
                ;
                String endText = item.getNodeText().substring(start + 1, item.getNodeText().length());
                result2.put(startText, endText);
            }
        }

        //指标
        Map<String, String> result3 = new HashMap<>();
        for (AiGcPreprocEntity item : breakDownTextList3) {
            if (item.getNodeText().contains("Reference")) {
                int start = item.getNodeText().indexOf("：");
                String startText = item.getNodeText().substring(0, start).replace("*", "");
                String endText = item.getNodeText().substring(start + 1, item.getNodeText().length());
                result3.put(startText, endText);
            }
        }

        for (AiGcPreprocEntity item : frameworkTextList) {
            if (item.getNodeText().contains("Reference")) {
                int count = 0;
                if (item.getNodeLevel() == 2) {
                    count = 0;
                } else if (item.getNodeLevel() == 3) {
                    count = 2;
                } else if (item.getNodeLevel() == 4) {
                    count = 4;
                } else if (item.getNodeLevel() == 5) {
                    count = 6;
                } else if (item.getNodeLevel() == 6) {
                    count = 8;
                }
                String space = StrUtils.getSpaceByCount(" ", count) + "- ";
                String frameworkReference = item.getNodeText().substring(count, item.getNodeText().length());
                String breakDownText2 = result2.get(frameworkReference);
                String breakDownText3 = result3.get(frameworkReference);
                String nodeText = "";
                if (!StringUtils.isEmpty(breakDownText2) && !StringUtils.isEmpty(breakDownText3)) {
                    nodeText = space + breakDownText2 + "； " + breakDownText3;
                } else if (!StringUtils.isEmpty(breakDownText2)) {
                    nodeText = space + breakDownText2;
                } else if (!StringUtils.isEmpty(breakDownText3)) {
                    nodeText = space + breakDownText3;
                }
                item.setNodeText(nodeText);
            }
        }

        frameworkTextList.sort(Comparator.comparing(o -> o.getNodeOrder()));
        StringBuffer buffer = new StringBuffer();
        for (int i = 0; i < frameworkTextList.size(); i++) {
            AiGcPreprocEntity entity = frameworkTextList.get(i);
            if (entity.getNodeLevel() <= 1) {
                buffer.append("\n").append(entity.getNodeText()).append("\n");
            } else if (StringUtils.isNotEmpty(entity.getNodeText())) {
                buffer.append(entity.getNodeText()).append("\n");
            }
        }
        return buffer.toString();
    }
