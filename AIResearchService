    /**
     * 提交新的向量库
     * @param requestBean
     * @return
     */
    public boolean submitPost(AliceRequestBean requestBean) {
        //查询是否提交过向量库
        String checkVectorUrl = config.getProperty("docRecall.checkVector.existsUrl", "http://10.25.3.215:8000/docVector/v1/exists?doc_id=%s");
        //String checkVectorUrl = config.getProperty("docRecall.checkVector.existsUrl", "http://10.15.4.107:8000/docVector/v1/exists-fulltext?doc_id=%s");
        checkVectorUrl = String.format(checkVectorUrl, requestBean.getDecDocIdAndAttId());
        String checkResult = httpProxyDecorator.getNewsVectorStatus(checkVectorUrl + "&bizType=first");
        if (StringUtils.isEmpty(checkResult)) {
            return false;
        }
        JSONObject checkResultJson = JSONObject.parseObject(checkResult);
        int code = checkResultJson.getIntValue("code");
        if (code == 0) {
            return true;
        }
        String status = checkResultJson.getJSONObject("data").getString("status");
        if (StringUtils.isNotEmpty(status) && (status.equals("missing") || status.equals("failed"))) {
            //没有提交过向量库提交向量
            String submitVectorUrl = config.getProperty("docRecall.checkVector.sumbmitUrl", "http://10.25.3.215:8000/docVector/v1/submit");
            //String submitVectorUrl = config.getProperty("docRecall.checkVector.sumbmitUrl", "https://test.wind.com.cn/docVector/v1/submit");
            Map<String, String> paraMap = new HashMap<>();
            paraMap.put("doc_id", requestBean.getDecryptDocId());
            paraMap.put("doc_type", requestBean.getDocType());
            String submitResult = httpProxyDecorator.postV2(submitVectorUrl, JSONObject.toJSONString(paraMap));
            if (StringUtils.isEmpty(submitResult)) {
                //mailUtils.sendMail("摘要向量库提交失败","返回结果="+submitResult+"\ndocId="+requestBean.getDocId(),"newVector");
                return false;
            }
            JSONObject submitResultJson = JSONObject.parseObject(submitResult);
            int submitCode = submitResultJson.getIntValue("code");
            if (submitCode != 0) {
                return false;
            }
            return true;
        }
        long sleepTime = config.getLongProperty("query.abstract.vector.sleep.time", 4000l);
        int queryCounts = config.getIntProperty("query.vector.abstract.counts", 3);
        int count = 0;
        //查询提交结果
        while (true) {
            ThreadUtil.sleep(sleepTime);
            if (count > queryCounts) {
                return false;
            }
            checkResult = httpProxyDecorator.getNewsVectorStatus(checkVectorUrl + "&bizType=Polling" + count);
            if (StringUtils.isEmpty(checkResult)) {
                return false;
            }
            checkResultJson = JSONObject.parseObject(checkResult);
            code = checkResultJson.getIntValue("code");
            if (code == 0) {
                return true;
            }
            status = checkResultJson.getJSONObject("data").getString("status");
            if (StringUtils.isEmpty(status)) {
                //mailUtils.sendMail("摘要向量库状态","返回结果="+checkResult+"\ndocId="+requestBean.getDocId(),"newVector");
                return false;
            }
            if (StringUtils.isNotEmpty(status) && status.equals("failed")) {//提交向量库失败了
                return false;
            }
            count++;
        }
    }

