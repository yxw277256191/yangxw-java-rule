    /**
     * AI投研框架->列表选项AIGC， 汇总用流输出
     * @param request
     * @return
     */
    public StreamChatResponse aiResearchAigc(AiResearchRequest request) {
        log.info("AIResearchService.aiResearchAigc: {}", JSONObject.toJSON(request));
        if(CollectionUtils.isEmpty(request.getDocBean()) || StringUtils.isBlank(request.getNodeType())){
            return null;
        }
        if(request.getNodeType().equals(Constants.NodeType.ONE)){
            //1:生成框架
            StreamChatResponse streamChatResponse = this.aigcFramework(request);
            return streamChatResponse;
        } else if (request.getNodeType().equals(Constants.NodeType.TWO)) {
            //2:拆解
            StreamChatResponse streamChatResponse = this.aigcBreakDown(request);
            return streamChatResponse;
        }
        return null;
    }


    /**
     * AI投研框架->列表选项AIGC， 汇总用流输出  2:拆解
     * @param request
     * @return
     */
    public StreamChatResponse aigcBreakDown(AiResearchRequest request) {
        String question = "拆解上市公司的研究内容";
        //内容集合
        StringBuffer resultList = new StringBuffer();
        List<String> resultTxtList = new ArrayList<>();
        //调用pmpAigc非流接口集合bean
        List<PmpAigcBean> pmpAigcBeanList = new ArrayList<>();
        MDC.put(InjectVariable.TRACE_QUESTION, question);
        AiResearchRequest requestReids = new AiResearchRequest();
        BeanUtils.copyProperties(request, requestReids);
        List<DocBean> paramsList = request.getDocBean();
        for (int i = 0; i < paramsList.size(); i++) {
            DocBean docBean = paramsList.get(i);
            if(!docBean.isSubmitFlag()){
                //continue;
            }
            //设置缓存key
            requestReids.setDocBean(new ArrayList<>());
            List<DocBean> docBeanList = new ArrayList<>();
            docBeanList.add(docBean);
            requestReids.setDocBean(docBeanList);
            String reidskey = "Wind.Stock.AIresearch.Framework" + String.format(".AIResearchService.aigcBreakDown::%s", MD5Util.encrypt32(JSON.toJSONString(requestReids)));
            //1、原文切片 调用文档 获取文本内容
            AliceRequestBean bean = new AliceRequestBean();
            bean.setDocName(docBean.getDocName());
            bean.setDocId(docBean.getDocId());
            bean.setDocSource(Constants.DocSource.ONE);
            bean.setUrl(docBean.getUrl());
            bean.setDocType(Constants.DocType.THREE);
            log.info("getPDF:{}", JSONObject.toJSON(bean));
            //查询文档元信息
            JSONObject jsonBean = this.getPDF(bean);
            if(jsonBean==null){
                log.info(".AIResearchService.aigcBreakDownNoStream -> jsonBean:{}, DocName:{}", jsonBean, docBean.getDocName());
                continue;
            }
            //解析文档元信息  原文切片
            List<String> breakPDFList = this.analysisBreakPDF(jsonBean, docBean.getPagesizeSplit());
            StringBuffer breakText = new StringBuffer();
            if (!CollectionUtils.isEmpty(breakPDFList)) {
                //原文切片 调用pmpAigc非流接口集合bean
                List<PmpAigcBean> breakAigcBeanList = new ArrayList<>();
                for (String strText: breakPDFList) {
                    Map<String,String> paraMap = new HashMap<>();
                    paraMap.put("companyName", request.getCompanyName());
                    paraMap.put("content", strText);
                    paraMap.put("question", question);
                    //用pmpAigc非流接口集合bean 前组装数据 用线程执行
                    PmpAigcBean breakAigcBean = new PmpAigcBean();
                    breakAigcBean.setReidskey(reidskey);
                    breakAigcBean.setDocId(docBean.getDocId());
                    breakAigcBean.setTitle(docBean.getTitle());
                    breakAigcBean.setPromptId(docBean.getPromptId());
                    breakAigcBean.setDocName(docBean.getDocName());
                    breakAigcBean.setUrl(docBean.getUrl());
                    breakAigcBean.setEventStreamFlg(true);
                    breakAigcBean.setParaMap(paraMap);
                    breakAigcBean.setTaskId(docBean.getTaskId());
                    breakAigcBean.setWindCode(docBean.getWindCode());
                    breakAigcBean.setNodeType(request.getNodeType());
                    breakAigcBeanList.add(breakAigcBean);
                }

                List<String> breakTxtList = new ArrayList<>();
                //start 原文切片 线程
                if (breakAigcBeanList.size() > 0) {
                    ExecutorService executorService = new ThreadPoolExecutor(breakAigcBeanList.size(), breakAigcBeanList.size(), 0, TimeUnit.MILLISECONDS, new LinkedBlockingQueue<>());
                    List<Callable<Object>> tasks = new LinkedList<>();
                    try {
                        for (PmpAigcBean pmpAigcBean: breakAigcBeanList) {
                            log.info("AIResearchService.break.pmpAigcNoStreamThread docName:{}", pmpAigcBean.getDocName());
                            Map<String, String> copyOfContextMap = MDC.getCopyOfContextMap();
                            tasks.add(() -> {
                                try {
                                    MDC.setContextMap(copyOfContextMap);
                                    aliceAigcAnswerHttpClient.pmpAigcNoStreamThread(breakTxtList, pmpAigcBean);
                                    return null;
                                } catch (Exception e) {
                                    throw new RuntimeException(e);
                                } finally {
                                    MDC.clear();
                                }
                            });
                        }
                        executorService.invokeAll(tasks, 120, TimeUnit.SECONDS);
                    } catch (Exception e) {
                        log.error("executorService:", e);
                    } finally {
                        // 关闭线程池 并等待所有任务完成
                        executorService.shutdown();
                    }
                    //判断线程是否执行完毕
                    boolean isTerminated = executorService.isTerminated();
                    log.info("AIResearchService.break.isTerminated:{}, breakTxtList.size()={}", isTerminated, breakTxtList.size());
                }
                //原文切片AIGC 内容汇总
                for (String result: breakTxtList) {
                    breakText.append("\n\n").append(result);
                }

                //3、合并AIGC内容，再次调用AIGC非流接口 breakText 合并在AIGC  固定值 P042848
                String promptId = Constants.PromptId.PromptId_2_P042848;
                String companyName = request.getCompanyName();
                String content = breakText.toString();
                HashMap promptParams = new HashMap();
                if (StringUtils.isNotBlank(companyName)) {
                    promptParams.put("companyName", companyName);
                }
                if (StringUtils.isNotBlank(question)) {
                    promptParams.put("question", question);
                }
                if (StringUtils.isNotBlank(content)) {
                    promptParams.put("content", content);
                }
                String answer = aliceAigcAnswerHttpClient.pmpAigcNoStreamNew(promptParams, promptId);
                //存库
                if (StringUtils.isNotEmpty(answer)) {
                    AiGcBaseRequest temp = new AiGcBaseRequest();
                    temp.setDocId(docBean.getDocId());
                    temp.setWindCode(docBean.getWindCode());
                    temp.setPromptId(promptId);
                    temp.setNodeType(request.getNodeType());
                    temp.setText(answer);
                    temp.setCreator("systemt");
                    mongoDBService.insertMongoAiGcBase(temp);
                }
                //end

                //2、调用AIGC非流接口，获取内容
                boolean eventStreamFlg = request.getEventStreamFlg();
                Map<String,String> paraMap = new HashMap<>();
                paraMap.put("companyName", request.getCompanyName());
                paraMap.put("content", answer);
                paraMap.put("question", question);
                //用pmpAigc非流接口集合bean 前组装数据 用线程执行
                PmpAigcBean pmpAigcBean = new PmpAigcBean();
                pmpAigcBean.setReidskey(reidskey);
                pmpAigcBean.setDocId(docBean.getDocId());
                pmpAigcBean.setPromptId(request.getPromptId());
                pmpAigcBean.setEventStreamFlg(eventStreamFlg);
                pmpAigcBean.setParaMap(paraMap);
                pmpAigcBean.setWindCode(docBean.getWindCode());
                pmpAigcBean.setNodeType(request.getNodeType());
                pmpAigcBeanList.add(pmpAigcBean);
            }
        }

        //start 线程
        if (pmpAigcBeanList.size() > 0) {
            ExecutorService executorService = new ThreadPoolExecutor(pmpAigcBeanList.size(), pmpAigcBeanList.size(), 0, TimeUnit.MILLISECONDS, new LinkedBlockingQueue<>());
            List<Callable<Object>> tasks = new LinkedList<>();
            try {
                for (PmpAigcBean pmpAigcBean: pmpAigcBeanList) {
                    AiGcBaseRequest baseRequest = new AiGcBaseRequest();
                    baseRequest.setDocId(pmpAigcBean.getDocId());
                    baseRequest.setWindCode(pmpAigcBean.getWindCode());
                    baseRequest.setPromptId(pmpAigcBean.getPromptId());
                    baseRequest.setNodeType(pmpAigcBean.getNodeType());
                    String mongoValue = mongoDBService.findMongoAiGcBase(baseRequest);
                    if (StringUtils.isNotEmpty(mongoValue)) {
                        resultTxtList.add(mongoValue);
                        log.info("findMongoPreproc.docId:{}", pmpAigcBean.getDocId());
                        log.info("findMongoPreproc.mongoValue:{}", mongoValue);
                    } else {
                        Map<String, String> copyOfContextMap = MDC.getCopyOfContextMap();
                        tasks.add(() -> {
                            try {
                                MDC.setContextMap(copyOfContextMap);
                                aliceAigcAnswerHttpClient.pmpAigcNoStreamThread(resultTxtList, pmpAigcBean);
                                return null;
                            } catch (Exception e) {
                                throw new RuntimeException(e);
                            } finally {
                                MDC.clear();
                            }
                        });
                    }
                }
                executorService.invokeAll(tasks, 120, TimeUnit.SECONDS);
            } catch (Exception e) {
                log.error("executorService:", e);
            } finally {
                // 关闭线程池 并等待所有任务完成
                executorService.shutdown();
            }
            //判断线程是否执行完毕
            boolean isTerminated = executorService.isTerminated();
            log.info("AIResearchService.isTerminated:{}, resultTxtList.size()={}", isTerminated, resultTxtList.size());
        }
        //end

        //内容合并
        for (String result: resultTxtList) {
            resultList.append("\n\n").append(result);
        }

        if(StringUtils.isEmpty(resultList.toString())){
            return null;
        }
        //3、合并AIGC内容，再次调用AIGC流接口
        String promptId = request.getPromptId();
        String companyName = request.getCompanyName();
        StreamChatResponse streamChatResponse = aliceAigcAnswerHttpClient.aigcResearchInfo("", promptId, companyName, resultList.toString(), question, "");
        return streamChatResponse;
    }

    /**
     * AI投研框架->列表选项AIGC， 汇总用流输出  1:生成框架
     * @param request
     * @return
     */
    public StreamChatResponse aigcFramework(AiResearchRequest request) {
        String question = "总结上市公司的研究框架";
        //内容集合
        StringBuffer resultList = new StringBuffer();
        List<String> resultTxtList = new ArrayList<>();
        //调用pmpAigc非流接口集合bean
        List<PmpAigcBean> pmpAigcBeanList = new ArrayList<>();
        MDC.put(InjectVariable.TRACE_QUESTION, question);
        AiResearchRequest requestReids = new AiResearchRequest();
        BeanUtils.copyProperties(request, requestReids);

        List<DocBean> paramsList = request.getDocBean();
        for (int i = 0; i < paramsList.size(); i++) {
            DocBean docBean = paramsList.get(i);
            if(!docBean.isSubmitFlag()){
                continue;
            }
            //设置缓存key
            requestReids.setDocBean(new ArrayList<>());
            List<DocBean> docBeanList = new ArrayList<>();
            docBeanList.add(docBean);
            requestReids.setDocBean(docBeanList);
            String reidskey = "Wind.Stock.AIresearch.Framework" + String.format(".AIResearchService.aigcFramework::%s", MD5Util.encrypt32(JSON.toJSONString(requestReids)));

            String contentText = "";

            //1、调用向量召回接口 获取文本内容
            if (StringUtils.isEmpty(contentText)) {
                //start 向量召回接口  切换新项目 Wind.Stock.DocRecall.Service
                //String lan = "cn";
                String docSource = "1";
                String oceanId = oceanDecryptExpoClient.decrypt(docBean.getDocId(), docSource);
                //OceanDocumentDetailBean.Paragraph[] paragraphs = aliceRelevantHttpClient.retrieveV4(lan, oceanId, question, docSource);
                //contentText = Arrays.stream(paragraphs).map(OceanDocumentDetailBean.Paragraph::getText).collect(Collectors.joining("\n"));
                contentText = aliceRelevantHttpClient.retrieveV4(oceanId, question);
                //end
                log.info("AIResearchService.aigcFramework.retrieveV4 result  -> docName：{}", docBean.getDocName());
            }
            if(StringUtils.isEmpty(contentText)){
                log.info("AIResearchService.contentText isEmpty 向量召回返回失败 -> docName：{}", docBean.getDocName());
                continue;
            }
            //2、调用AIGC非流接口，获取内容
            String promptId = docBean.getPromptId();
            Map<String,String> paraMap = new HashMap<>();
            paraMap.put("companyName", request.getCompanyName());
            paraMap.put("content", contentText);
            paraMap.put("question", question);
            //用pmpAigc非流接口集合bean 前组装数据 用线程执行
            PmpAigcBean pmpAigcBean = new PmpAigcBean();
            pmpAigcBean.setReidskey(reidskey);
            pmpAigcBean.setDocId(docBean.getDocId());
            pmpAigcBean.setTitle(docBean.getTitle());
            pmpAigcBean.setPromptId(promptId);
            pmpAigcBean.setParaMap(paraMap);
            pmpAigcBean.setEventStreamFlg(true);
            pmpAigcBean.setTaskId(docBean.getTaskId());
            pmpAigcBean.setWindCode(docBean.getWindCode());
            pmpAigcBean.setNodeType(request.getNodeType());
            pmpAigcBeanList.add(pmpAigcBean);
        }

        if(request.isSelfDocFlg() && pmpAigcBeanList.size() > 0){
            //是否N+1 自有文档 固定值  P045503
            PmpAigcBean pmpAigcBean1 = new PmpAigcBean();
            String md5 = pmpAigcBeanList.get(0).getWindCode() + request.getCompanyName();
            pmpAigcBean1.setDocId(MD5Util.encrypt32(md5));
            pmpAigcBean1.setTitle(request.getCompanyName()+ "-自有文档");
            pmpAigcBean1.setPromptId(Constants.PromptId.PromptId_1_P045503);
            Map<String,String> paraMap1 = new HashMap<>();
            paraMap1.put("companyName", request.getCompanyName());
            pmpAigcBean1.setParaMap(paraMap1);
            pmpAigcBean1.setEventStreamFlg(true);
            pmpAigcBean1.setWindCode(pmpAigcBeanList.get(0).getWindCode());
            pmpAigcBean1.setNodeType(request.getNodeType());
            String reidskey1 = "Wind.Stock.AIresearch.Framework" + String.format(".AIResearchService.aigcFramework.isNpromptIdFlg::%s", MD5Util.encrypt32(JSON.toJSONString(pmpAigcBean1)));
            pmpAigcBean1.setReidskey(reidskey1);
            pmpAigcBeanList.add(pmpAigcBean1);
        }

        //start 线程
        if (pmpAigcBeanList.size() > 0) {
            ExecutorService executorService = new ThreadPoolExecutor(pmpAigcBeanList.size(), pmpAigcBeanList.size(), 0, TimeUnit.MILLISECONDS, new LinkedBlockingQueue<>());
            List<Callable<Object>> tasks = new LinkedList<>();
            try {
                for (PmpAigcBean pmpAigcBean: pmpAigcBeanList) {
                    AiGcBaseRequest baseRequest = new AiGcBaseRequest();
                    baseRequest.setDocId(pmpAigcBean.getDocId());
                    baseRequest.setWindCode(pmpAigcBean.getWindCode());
                    baseRequest.setPromptId(pmpAigcBean.getPromptId());
                    baseRequest.setNodeType(pmpAigcBean.getNodeType());
                    String mongoValue = mongoDBService.findMongoAiGcBase(baseRequest);
                    if (StringUtils.isNotEmpty(mongoValue)) {
                        resultTxtList.add(mongoValue);
                    } else {
                        Map<String, String> copyOfContextMap = MDC.getCopyOfContextMap();
                        log.info("AIResearchService.pmpAigcNoStreamThread docName:{}", pmpAigcBean.getDocName());
                        tasks.add(() -> {
                            try {
                                MDC.setContextMap(copyOfContextMap);
                                aliceAigcAnswerHttpClient.pmpAigcNoStreamThread(resultTxtList, pmpAigcBean);
                                return null;
                            } catch (Exception e) {
                                throw new RuntimeException(e);
                            }finally {
                                MDC.clear();
                            }
                        });
                    }
                }
                executorService.invokeAll(tasks, 120, TimeUnit.SECONDS);
            } catch (Exception e) {
                log.error("AIResearchService.executorService:", e);
            } finally {
                // 关闭线程池 并等待所有任务完成
                executorService.shutdown();
            }
            //判断线程是否执行完毕
            boolean isTerminated = executorService.isTerminated();
            log.info("AIResearchService.isTerminated:{}, resultTxtList.size()={}", isTerminated, resultTxtList.size());
        }
        //end

        //内容合并
        for (String result: resultTxtList) {
            resultList.append("\n\n").append(result);
        }

        if(StringUtils.isEmpty(resultList.toString())){
            return null;
        }

        if (resultTxtList.size() > 0) {
            //start  单个文档AIGC内容存 MongoDB 预先执行AIGC
            for (PmpAigcBean pmpAigcBean: pmpAigcBeanList) {
                //缓存数据
                String reidsvalue = redisManager.get(pmpAigcBean.getReidskey());
                if (StringUtils.isNotEmpty(reidsvalue)) {
                    AiGcBaseRequest temp = new AiGcBaseRequest();
                    temp.setDocId(pmpAigcBean.getDocId());
                    temp.setWindCode(pmpAigcBean.getWindCode());
                    temp.setPromptId(pmpAigcBean.getPromptId());
                    temp.setText(reidsvalue);
                    temp.setNodeType(pmpAigcBean.getNodeType());
                    temp.setCreator("systemt");
                    mongoDBService.insertMongoAiGcBase(temp);
                }
            }
            //end
        }
        //end

        //股票代码 查找行业，映射枚举值
        String industryType = "";
        String framework = "";
        if(request.getNodeType().equals(Constants.NodeType.ONE)){
            String windCode = request.getDocBean().get(0).getWindCode();
            String userId = config.getProperty("data.framework.userId", "6938791");
            List<String> industryTypeList = teamIntroduceService.getIndustryType(windCode, Long.valueOf(userId));
            log.info("industryTypeList:{}", JSONObject.toJSON(industryTypeList));
            if(!CollectionUtils.isEmpty(industryTypeList)){
                industryType = industryTypeList.get(0);
                framework = MapEnumConstant.industryTypeMap.get(industryType);
            }
            log.info("windCode:{}, industryType:{}, framework:{}", windCode, industryType, framework);
        }

        //3、合并AIGC内容，再次调用AIGC流接口
        String promptId = request.getPromptId();
        String companyName = request.getCompanyName();
        StreamChatResponse streamChatResponse = aliceAigcAnswerHttpClient.aigcResearchInfo(framework, promptId, companyName, resultList.toString(), question, "");
        return streamChatResponse;
    }




