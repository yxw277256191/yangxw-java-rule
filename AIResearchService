    /**
     * AI投研框架->列表选项AIGC， 汇总用流输出
     * @param request
     * @return
     */
    public String aigcNoStreamRe(AiResearchReRequest request) {
        log.info("aigcNoStreamRe: {}", JSONObject.toJSON(request));
        if(CollectionUtils.isEmpty(request.getDocBean()) || StringUtils.isBlank(request.getNodeType())){
            return null;
        }

        //请求报文唯一标识
        List<PmpAigcBean> md5AigcBeanList = new ArrayList<>();
        List<DocBean> md5paramsList = request.getDocBean();
        for (int i = 0; i < md5paramsList.size(); i++) {
            DocBean docBean = md5paramsList.get(i);
            //验证是否有数据 start
            AiGcBaseRequest baseRequest = new AiGcBaseRequest();
            baseRequest.setDocId(docBean.getDocId());
            baseRequest.setWindCode(docBean.getWindCode());
            baseRequest.setNodeType(request.getNodeType());
            //start 查询AI数据是否已经存在
            if (request.getNodeType().equals(Constants.NodeType.ONE)) {
                baseRequest.setPromptId(Constants.PromptId.PromptId_1_P042185);
            } else if (request.getNodeType().equals(Constants.NodeType.TWO)) {
                baseRequest.setPromptId(Constants.PromptId.PromptId_2_P042848);
            }
            List<AiGcBaseEntity> mongoValueList = mongoDBService.findMongoAiGcBaseList(baseRequest);
            if (mongoValueList.size() == 0) {
                continue;
            }
            //end
            PmpAigcBean md5AigcBean = new PmpAigcBean();
            md5AigcBean.setDocId(docBean.getDocId());
            md5AigcBean.setDocName(docBean.getDocName());
            md5AigcBean.setPromptId(docBean.getPromptId());
            md5AigcBean.setWindCode(docBean.getWindCode());
            md5AigcBean.setNodeType(request.getNodeType());
            md5AigcBeanList.add(md5AigcBean);
        }
        // 排序
        List<PmpAigcBean> sortedList = md5AigcBeanList.stream().sorted(Comparator.comparing(PmpAigcBean::getDocId)).collect(Collectors.toList());
        String md5 = MD5Util.encrypt32(JSON.toJSONString(sortedList));
        request.setMd5(md5);

        AiGcPreprocRequest preprocRequest = new AiGcPreprocRequest();
        preprocRequest.setMd5(request.getMd5());
        preprocRequest.setWindCode(request.getDocBean().get(0).getWindCode());
        preprocRequest.setNodeType(request.getNodeType());
        String answerMG = this.getHangTreeText(preprocRequest);
        //指标测试，先不用 MD5
        if(StringUtils.isNotEmpty(answerMG) && !request.getNodeType().equals(Constants.NodeType.FOUR)){
            return answerMG;
        }else{
            String answer = "";
            if(request.getNodeType().equals(Constants.NodeType.ONE)){
                //1:生成框架
                answer = this.aigcFrameworkNoStreamRe(request);
            } else if (request.getNodeType().equals(Constants.NodeType.TWO)) {
                //2:拆解
                answer = this.aigcBreakDownNoStreamRe(request);
            } else if (request.getNodeType().equals(Constants.NodeType.FOUR)) {
                //4:指标
                answer = this.aigcIndNoStreamRe(request);
            }
            return answer;
        }
    }

    /**
     * 重新汇总
     * AI投研框架->列表选项AIGC， 汇总用流输出  1:生成框架
     * @param request
     * @return
     */
    public String aigcFrameworkNoStreamRe(AiResearchReRequest request) {
        String question = "总结上市公司的研究框架";
        //内容集合
        StringBuffer resultList = new StringBuffer();
        List<String> resultTxtList = new ArrayList<>();
        //调用pmpAigc非流接口集合bean
        List<PmpAigcBean> pmpAigcBeanList = new ArrayList<>();

        List<DocBean> paramsList = request.getDocBean();
        for (int i = 0; i < paramsList.size(); i++) {
            DocBean docBean = paramsList.get(i);
            if(!docBean.isSubmitFlag()){
                //continue; 汇总直接查 完成数据，不需要验证向量化接口
            }
            PmpAigcBean pmpAigcBean = new PmpAigcBean();
            pmpAigcBean.setDocId(docBean.getDocId());
            pmpAigcBean.setDocName(docBean.getDocName());
            pmpAigcBean.setTitle(docBean.getTitle());
            pmpAigcBean.setPromptId(docBean.getPromptId());
            pmpAigcBean.setEventStreamFlg(true);
            pmpAigcBean.setTaskId(docBean.getTaskId());
            pmpAigcBean.setWindCode(docBean.getWindCode());
            pmpAigcBean.setNodeType(request.getNodeType());
            pmpAigcBeanList.add(pmpAigcBean);
        }

        //自有文档
        if(request.isSelfDocFlg() && pmpAigcBeanList.size() > 0){
            //是否N+1 自有文档 固定值  P045503
            PmpAigcBean pmpAigcBean1 = new PmpAigcBean();
            String md5 = pmpAigcBeanList.get(0).getWindCode() + request.getCompanyName();
            pmpAigcBean1.setDocId(MD5Util.encrypt32(md5));
            pmpAigcBean1.setDocName(request.getCompanyName()+ "-自有文档");
            pmpAigcBean1.setTitle(request.getCompanyName()+ "-自有文档");
            pmpAigcBean1.setPromptId(Constants.PromptId.PromptId_1_P045503);
            pmpAigcBean1.setEventStreamFlg(true);
            pmpAigcBean1.setWindCode(pmpAigcBeanList.get(0).getWindCode());
            pmpAigcBean1.setNodeType(request.getNodeType());
            pmpAigcBeanList.add(pmpAigcBean1);
        }

        //执行AIGC文档列表 //勾选的文档ID，过滤向量失败的文档ID
        List<DocListBean> docListBeanList = new ArrayList<>();
        for (PmpAigcBean pmpAigcBean: pmpAigcBeanList) {
            AiGcBaseRequest baseRequest = new AiGcBaseRequest();
            baseRequest.setDocId(pmpAigcBean.getDocId());
            baseRequest.setWindCode(pmpAigcBean.getWindCode());
            baseRequest.setPromptId(pmpAigcBean.getPromptId());
            baseRequest.setNodeType(pmpAigcBean.getNodeType());
            String mongoValue = mongoDBService.findMongoAiGcBase(baseRequest);
            if (StringUtils.isNotEmpty(mongoValue)) {
                resultTxtList.add(mongoValue);

                DocListBean docListBean = new DocListBean();
                docListBean.setFrameworkDocId(pmpAigcBean.getDocId());
                docListBean.setFrameworkDocName(pmpAigcBean.getDocName());
                docListBeanList.add(docListBean);
            }
        }

        //内容合并
        for (String result: resultTxtList) {
            resultList.append("\n\n").append(result);
        }

        if (StringUtils.isEmpty(resultList.toString())) {
            return null;
        }

        //股票代码 查找行业，映射枚举值
        String industryType = "";
        String framework = "";
        if(request.getNodeType().equals(Constants.NodeType.ONE)){
            String windCode = request.getDocBean().get(0).getWindCode();
            String userId = config.getProperty("data.framework.userId", "6938791");
            List<String> industryTypeList = teamIntroduceService.getIndustryType(windCode, Long.valueOf(userId));
            log.info("industryTypeList:{}", JSONObject.toJSON(industryTypeList));
            if(!CollectionUtils.isEmpty(industryTypeList)){
                industryType = industryTypeList.get(0);
                framework = MapEnumConstant.industryTypeMap.get(industryType);
            }
            log.info("windCode:{}, industryType:{}, framework:{}", windCode, industryType, framework);
        }

        //3、合并AIGC内容，再次调用AIGC非流接口
        String promptId = request.getPromptId();
        String companyName = request.getCompanyName();
        String content = resultList.toString();

        HashMap promptParams = new HashMap();
        if (StringUtils.isNotBlank(companyName)) {
            promptParams.put("companyName", companyName);
        }
        if (StringUtils.isNotBlank(question)) {
            promptParams.put("question", question);
        }
        if (StringUtils.isNotBlank(content)) {
            promptParams.put("content", content);
        }
        if (StringUtils.isNotBlank(framework)) {
            promptParams.put("framework", framework);
        }
        String answer = aliceAigcAnswerHttpClient.pmpAigcNoStreamNew(promptParams, promptId);

        AiGcPreprocRequest preprocRequest = new AiGcPreprocRequest();
        preprocRequest.setWindCode(request.getDocBean().get(0).getWindCode());
        preprocRequest.setNodeType(request.getNodeType());
        preprocRequest.setPromptId(request.getPromptId());
        preprocRequest.setText(answer.toString());
        preprocRequest.setDocListBean(docListBeanList);
