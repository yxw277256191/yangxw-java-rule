    public String hangTreeAigcNoStream(AiHangTreeRequest request) {
        //3、合并AIGC内容，再次调用AIGC流接口
        if (StringUtils.isEmpty(request.getWindCode())) {
            return "";
        }
        request.setNodeType(StringUtils.isEmpty(request.getNodeType()) ? Constants.NodeType.THREE : request.getNodeType());

        //获取框架信息
        AiGcPreprocRequest request1 = new AiGcPreprocRequest();
        request1.setWindCode(request.getWindCode());
        request1.setNodeType(Constants.NodeType.ONE);
        request1.setPromptId(Constants.PromptId.PromptId_1_P042256);
        List<AiGcPreprocEntity> list = mongoDBService.findMongoPreprocList(request1);
        if (CollectionUtils.isEmpty(list)) {
            return "";
        }
        list.sort(Comparator.comparing(o -> o.getNodeOrder()));
        StringBuffer buffer = new StringBuffer();
        for (int i = 0; i < list.size(); i++) {
            AiGcPreprocEntity entity = list.get(i);
            if(entity.getNodeLevel() <= 1){
                buffer.append("\n").append(entity.getNodeText()).append("\n");
            }else{
                buffer.append(entity.getNodeText()).append("\n");
            }
        }
        String frameworkText = buffer.toString();
        request.setFrameworkText(frameworkText);

        //获取拆解信息
        AiGcPreprocRequest request2 = new AiGcPreprocRequest();
        request2.setWindCode(request.getWindCode());
        request2.setNodeType(Constants.NodeType.TWO);
        request2.setPromptId(Constants.PromptId.PromptId_2_P042254);
        String breakDownText = mongoDBService.findMongoPreproc(request2);
        request.setBreakDownText(breakDownText);
        if (StringUtils.isEmpty(breakDownText)) {
            return "";
        }

        //获取指标信息
        AiGcPreprocRequest request4 = new AiGcPreprocRequest();
        request4.setWindCode(request.getWindCode());
        request4.setNodeType(Constants.NodeType.FOUR);
        request4.setPromptId(Constants.PromptId.PromptId_4_P050620);
        String answerInd = mongoDBService.findMongoPreproc(request4);

        // 排序
        List<DocListBean> sortedList = list.get(0).getDocListBean().stream().filter(bean -> bean.getFrameworkDocId() != null).sorted(Comparator.comparing(DocListBean::getFrameworkDocId)).collect(Collectors.toList());
        // 排序
        String md5 = MD5Util.encrypt32(JSON.toJSONString(sortedList));
        if(StringUtils.isNotEmpty(answerInd)){
            md5 = MD5Util.encrypt32(JSON.toJSONString(sortedList + answerInd));
        }
        AiGcPreprocRequest yzRequest = new AiGcPreprocRequest();
        yzRequest.setMd5(md5);
        yzRequest.setWindCode(request.getWindCode());
        yzRequest.setNodeType(request.getNodeType());
        String answerMG = this.getHangTreeText(yzRequest);
        if(StringUtils.isNotEmpty(answerMG)){
            return answerMG;
        }

        //聚合
        String contentText = request.getFrameworkText() + "/n/n" + request.getBreakDownText();
        //"P042255";
        String promptId = request.getPromptId();
        String companyName = request.getCompanyName();

        HashMap promptParams = new HashMap();
        if (companyName != null) {
            promptParams.put("companyName", companyName);
        }
        if (contentText != null) {
            promptParams.put("content", contentText);
        }
        String answer = aliceAigcAnswerHttpClient.pmpAigcNoStreamNew(promptParams, promptId);

        if (StringUtils.isNotEmpty(answerInd)) {
            answer = this.hangTreeAigcNoStreamInd(request, answer);

            AiGcPreprocRequest preprocRequest = new AiGcPreprocRequest();
            preprocRequest.setWindCode(request.getWindCode());
            preprocRequest.setNodeType(request.getNodeType());
            preprocRequest.setPromptId(promptId);
            preprocRequest.setDocListBean(sortedList);
            preprocRequest.setText(answer);
            preprocRequest.setMd5(md5);
            this.saveHangTree(preprocRequest);
        }
        return answer;

    }


