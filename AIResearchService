    /**
     * 解析PDF文档内容，并分页切分 35kb内容
     * @param jsonPdfBean
     * @return
     */
    public List<String> analysisBreakPDF(JSONObject jsonPdfBean, String pagesizeSplit) {
        List<String> resultList = new ArrayList<>();
        //解析文档元信息
        PdfBean.Pesponse pdfBeanResponse = JSONObject.toJavaObject(jsonPdfBean, PdfBean.Pesponse.class);
        if (pdfBeanResponse != null) {
            Long total = pdfBeanResponse.getTotal();
            if (total > 30 && total <= 50) {
                total = total/2;
            } else if (total > 50) {
                total = 25L;
            }
            if(StringUtils.isNotBlank(pagesizeSplit)){
                total = Long.valueOf(pagesizeSplit);
            }
            log.info("total:{}, pagesizeSplit:{}" , total, pagesizeSplit);
            StringBuffer txtAppend = new StringBuffer("\n");
            List<PdfBean.Pesponse.Pages> pagesList = pdfBeanResponse.getPages();
            int count = 0;
            for (PdfBean.Pesponse.Pages pages: pagesList) {
                count++;
                StringBuffer paragraphAppend = new StringBuffer("\n");
                List<PdfBean.Pesponse.Pages.Paragraphs> paragraphs = pages.getParagraphs();
                for (PdfBean.Pesponse.Pages.Paragraphs paragraph: paragraphs) {
                    if (paragraph.getText().contains("资料来源") || paragraph.getText().contains("注：")) {
                    } else {
                        paragraphAppend.append(paragraph.getText()).append("\n");
                    }
                }

                StringBuffer tableAppend = new StringBuffer();
                List<PdfBean.Pesponse.Pages.Table> tables = pages.getTables();
                for (PdfBean.Pesponse.Pages.Table table: tables) {
                    List<List<PDFcells>> cells = table.getCells();
                    tableAppend.append(table.getTitle()).append("\n");
                    for (int i = 0; i < cells.size(); i++) {
                        tableAppend.append("|");
                        List<PDFcells> fcellsList = cells.get(i);
                        for (PDFcells pdFcells: fcellsList) {
                            tableAppend.append(pdFcells.getText()).append("|");
                        }
                        tableAppend.append("\n");
                    }

                }
                if(count > total){
                    log.info("count：{},txtAppend：{}", count, txtAppend.toString());
                    resultList.add(txtAppend.toString());
                    count = 0;
                    txtAppend = new StringBuffer("\n");
                }
                txtAppend.append(tableAppend).append(paragraphAppend);
            }
            log.info("total：{},txtAppend：{}", total, txtAppend.toString());
            resultList.add(txtAppend.toString());
        }
        return resultList;
    }

