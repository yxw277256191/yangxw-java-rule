        String publishVersion = "V1." + version;

        //查询版本表 是否有数据，设置版本递增
        AiGcReleaseVersionEntity versionEntity = new AiGcReleaseVersionEntity();
        versionEntity.setWindCode(request.getWindCode());
        versionEntity.setNodeType(request.getNodeType());
        versionEntity.setPromptId(request.getPromptId());
        versionEntity.setVersion(version);
        List<AiGcReleaseVersionEntity> releaseList = mongoDBService.findReleaseVersionList(versionEntity);
        if(!CollectionUtils.isEmpty(releaseList)){
            long size = releaseList.size() + 1;
            publishVersion = "V" + size + "." + version;
        }

        //发布版本表，存最新发版
        List<AiGcReleaseEntity> releaseEntityList = new ArrayList<>();
        for (AiGcReleaseHistoryEntity preBean: preList) {
            AiGcReleaseEntity releaseEntity = new AiGcReleaseEntity();
            BeanUtils.copyProperties(preBean, releaseEntity);
            releaseEntity.setPublishVersion(publishVersion);
            releaseEntity.setPublishDate(publishDate);
            releaseEntity.setId(null);
            releaseEntityList.add(releaseEntity);
        }
        mongoDBService.insertMongoRelease(releaseEntityList);

        //版本历史
        List<AiGcReleaseHistoryEntity> releaseHistoryList = new ArrayList<>();
        for (AiGcReleaseEntity releaseBean: releaseEntityList) {
            AiGcReleaseHistoryEntity releaseHistory = new AiGcReleaseHistoryEntity();
            BeanUtils.copyProperties(releaseBean, releaseHistory);
            releaseHistory.setVersion(version);
            releaseHistory.setId(null);
            releaseHistoryList.add(releaseHistory);
        }
        mongoDBService.insertReleaseHistory(releaseHistoryList);

        //版本记录
        versionEntity.setPublishVersion(publishVersion);
        versionEntity.setPublishDate(publishDate);
        versionEntity.setCreateTime(createTime);
        mongoDBService.insertReleaseVersion(versionEntity);

        //修改 研报列表 提供页面查询
        ResearchOverview entity = new ResearchOverview();
        entity.setWindCode(request.getWindCode());
        List<ResearchOverview> reportList = mapper.selectByExample(entity);
        if(!CollectionUtils.isEmpty(reportList)){
            ResearchOverview update = new ResearchOverview();
            update.setId(reportList.get(0).getId());
            update.setWindCode(reportList.get(0).getWindCode());
            update.setReportNumTask(preList.get(0).getDocListBean().size());
            if(request.getNodeType().equals(Constants.NodeType.ONE)){
                update.setCreateBy("Framework");
                update.setFrameworkStatus(2);
                update.setFrameworkVersion(publishVersion);
            }else if(request.getNodeType().equals(Constants.NodeType.TWO)){
                update.setCreateBy("BreakDown");
                update.setBreakDownStatus(2);
                update.setBreakDownVersion(publishVersion);
            }else if(request.getNodeType().equals(Constants.NodeType.THREE)){
                update.setCreateBy("HangTree");
                update.setHangTreeStatus(2);
                update.setHangTreeVersion(publishVersion);
            }
            update.setPublishVersion(publishVersion);
            mapper.updateByPrimaryKeySelective(update);
            //mongoDBService.updateResearchReport(update);
        }
    }

