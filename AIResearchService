            md5AigcBean.setNodeType(request.getNodeType());
            md5AigcBeanList.add(md5AigcBean);
        }
        // 排序
        List<PmpAigcBean> sortedList = md5AigcBeanList.stream().sorted(Comparator.comparing(PmpAigcBean::getDocId)).collect(Collectors.toList());
