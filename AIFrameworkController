        Map<String, String> CODE_NAME = new HashMap<>();
        if (StringUtils.isNotEmpty(request.getWindCode())) {
            CODE_NAME.put(request.getWindCode(), request.getWindCode());
        }

        for (Map.Entry<String, String> entry : CODE_NAME.entrySet()) {
            String key = entry.getKey();
            String value = entry.getValue();
            request.setWindCode(key);
            request.setCompanyName(value);
            //System.out.println("键: " + key + ", 值: " + value);
            String pagesize02 = StringUtils.isEmpty(request.getPagesize02()) ? "[20 TO 200]" : request.getPagesize02();
            String param_pagesize02 = " AND (pagesize02:" + pagesize02 + ")" +
                    " AND (!siteid:339 AND !siteid:113 AND !siteid:24 AND !siteid:33 AND !siteid:66 AND !siteid:27)";
            String param_v2 = "param_v2=(reporttype:806004002)" + param_pagesize02;
            if (StringUtils.isNotEmpty(request.getWindCode())) {
                String[] windCodeArr = request.getWindCode().split(",");
                int flag = 1;
                for (String windCode : windCodeArr) {
                    if (flag == 1) {
                        param_v2 = param_v2 + " AND (windcode:" + windCode;
                    } else {
                        param_v2 = param_v2 + " OR " + "windcode:" + windCode;
                    }
                    flag++;
                }
                param_v2 = param_v2 + ")";
            }

