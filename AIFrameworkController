    @OperateLogAop(operateMenu = OperateMenuEnums.Framework_publishReleaseBatch, operateAction = OperateLogTypeEnums.RELEASE_BATCH)
    @PostMapping("/framework/publishReleaseBatch")
    public Response publishReleaseBatch(@RequestBody BatchOverviewRequest request) {
        //给默认值
        request.setNodeType(StringUtils.isEmpty(request.getNodeType()) ? Constants.NodeType.ONE : request.getNodeType());
        if (StringUtils.isEmpty(request.getNodeType())) {
            return Response.ok("业务类型 不能为空！");
        }
        if (StringUtils.isEmpty(request.getPromptId())) {
            return Response.ok("模型ID 不能为空！，promptId");
        }
        if (request.isAllFlg()) {
            ResearchOverview reportEntity = new ResearchOverview();
            reportEntity.setWindCode(reportEntity.getWindCode());
            if (request.getNodeType().equals(Constants.NodeType.ONE)) {
                reportEntity.setFrameworkStatus(0);
            }
            if (request.getNodeType().equals(Constants.NodeType.TWO)) {
                reportEntity.setBreakDownStatus(0);
            }

            List<ResearchOverview> frameworkList = overviewService.selectByExample(reportEntity);
            for (ResearchOverview entity : frameworkList) {
                if (entity.getFrameworkStatus() == 2 && request.getNodeType().equals(Constants.NodeType.ONE)) {
                    continue;
                }
                if (entity.getBreakDownStatus() == 2 && request.getNodeType().equals(Constants.NodeType.TWO)) {
                    continue;
                }
                AiGcPreprocRequest preprocRequest = new AiGcPreprocRequest();
                preprocRequest.setWindCode(entity.getWindCode());
                preprocRequest.setPromptId(request.getPromptId());
                preprocRequest.setNodeType(request.getNodeType());
                log.info("publishReleaseBatch: WindCode{}, WindName:{}, PromptId:{}", entity.getWindCode(), entity.getCompanyName(), request.getPromptId());
                aiResearchService.publishRelease(preprocRequest);
            }
            return Response.ok();
        }
        if (CollectionUtils.isEmpty(request.getBatch())) {
            return Response.ok("请求报文不能为空！");
        }
        for (ResearchOverview reportEntity : request.getBatch()) {
            if (StringUtils.isEmpty(reportEntity.getWindCode())) {
                continue;
            }
            //查询列表数据
            reportEntity.setWindCode(reportEntity.getWindCode());
            List<ResearchOverview> frameworkList = overviewService.selectByExample(reportEntity);
            for (ResearchOverview entity : frameworkList) {
                AiGcPreprocRequest preprocRequest = new AiGcPreprocRequest();
                preprocRequest.setWindCode(entity.getWindCode());
                preprocRequest.setPromptId(request.getPromptId());
                preprocRequest.setNodeType(request.getNodeType());
                log.info("publishReleaseBatch: WindCode{}, WindName:{}, PromptId:{}", entity.getWindCode(), entity.getCompanyName(), request.getPromptId());
                aiResearchService.publishRelease(preprocRequest);
            }
        }
        return Response.ok();
    }

