        if (StringUtils.isBlank(request.getWindCode())) {
            return Response.ok("企业代码不能为空！");
        }
        if (StringUtils.isBlank(request.getNodeType())) {
            return Response.ok("业务类型不能为空！");
        }
        String list = aiResearchService.getAiGcPreTxt(request);
        return Response.ok(list);
    }

    /**
     * 聚合中间结果-非流输出
     * @param request
     * @return
     */
    @BuryingLog(apiUrl = "/framework/betweenTreeNoStream")
    @PostMapping("/framework/betweenTreeNoStream")
    public Response betweenTreeNoStream(@RequestBody AiHangTreeRequest request) {
        log.info("betweenTreeNoStream: {}", request);
        if (StringUtils.isNotEmpty(request.getCompanyName()) && request.getCompanyName().equals("test")) {
            return Response.ok("\\n## 奋达科技研究框架\\n");
        }
        if (StringUtils.isEmpty(request.getWindCode())) {
            return Response.ok("windCode 不能为空!");
        }
        String sessionId = config.getProperty("data.framework.sessionId", "87b8217fe4cb4c36a51b68400662a2db");
        String userId = config.getProperty("data.framework.userId", "6938791");
        MDC.put(InjectVariable.USER_ID, userId);
        UserBean userBean = new UserBean();
        userBean.setUserId(Integer.parseInt(userId));
        userBean.setSessionId(sessionId);
        MdcInjectAspect.USER_BEAN_THREAD_LOCAL.set(userBean);
        String windCode = StringUtils.isEmpty(request.getWindCode()) ? "" : request.getWindCode();
        String companyName = StringUtils.isEmpty(request.getCompanyName()) ? "" : request.getCompanyName();
        MDC.put(Constants.TRACE_QUESTION, windCode + companyName + "聚合");
        InjectVariable.setQuestionType(QuestionTypeEnum.AI_FRAMEWORK_QUESTION.getQuestionType());

        if(request.getNodeType().equals("7")){
            request.setNodeType(null);
            String list = aiResearchService.betweenTreeAppend(request);
            return Response.ok(list);
        } else if (StringUtils.isNotBlank(request.getNodeType())) {
            String answer = aiResearchService.betweenTreeNoStream(request);
            int end = answer.indexOf("</think>");
            if (end > 0) {
                answer = answer.substring(end, answer.length()).replace("</think>", "");
            }
            log.info("answerNew:{}", answer);
            if (StringUtils.isNotBlank(answer)) {
                return Response.ok(answer);
            } else {
                return Response.ok("no data!");
            }
        } else {
            String error = "参数错误，NodeType=" + request.getNodeType();
            return Response.ok(error);
        }
    }

