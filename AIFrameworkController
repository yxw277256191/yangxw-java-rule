    /**
     * AI投研框架->列表选项AIGC 流输出
     *
     * @param request
     * @return
     */
    @BuryingLog(apiUrl = "/framework/aigc")
    @PostMapping("/framework/aigc")
    public void aigc(@RequestBody AiResearchRequest request, HttpServletRequest req, HttpServletResponse res) {
        String sessionId = config.getProperty("data.framework.sessionId", "87b8217fe4cb4c36a51b68400662a2db");
        String userId = config.getProperty("data.framework.userId", "6938791");
        MDC.put(InjectVariable.USER_ID, userId);
        UserBean userBean = new UserBean();
        userBean.setUserId(Integer.parseInt(userId));
        userBean.setSessionId(sessionId);
        MdcInjectAspect.USER_BEAN_THREAD_LOCAL.set(userBean);
        InjectVariable.setQuestionType(QuestionTypeEnum.AI_FRAMEWORK_QUESTION.getQuestionType());
        log.info("AiResearchAigc: {}", request);
        String curOrigin = req.getHeader("Origin");
        res.setHeader("Access-Control-Allow-Origin", curOrigin == null ? "true" : curOrigin);
        res.setHeader("Access-Control-Allow-Credentials", "true");
        res.setHeader("Access-Control-Allow-Methods", "POST, GET, OPTIONS, DELETE, HEAD");
        res.setHeader("Access-Control-Max-Age", "3600");
        res.setHeader("Access-Control-Allow-Headers", "access-control-allow-origin, authority, content-type, version-info, X-Requested-With");
        res.setContentType("text/event-stream;charset=UTF-8");

        if (StringUtils.isNotEmpty(request.getCompanyName()) && request.getCompanyName().equals("test")) {
            try {
                res.getWriter().write("\t no data!");
                res.getWriter().flush();
            } catch (Exception e) {
                log.info("AIGC缓存数据:{}", e.getMessage());
            }
        }

        //请求报文唯一标识
        Set<PmpAigcBean> md5AigcBeanList = new TreeSet<>();
        List<DocBean> md5paramsList = request.getDocBean();
        for (int i = 0; i < md5paramsList.size(); i++) {
            DocBean docBean = md5paramsList.get(i);
            PmpAigcBean md5AigcBean = new PmpAigcBean();
            md5AigcBean.setDocId(docBean.getDocId());
            md5AigcBean.setDocName(docBean.getDocName());
            md5AigcBean.setPromptId(docBean.getPromptId());
            md5AigcBean.setWindCode(docBean.getWindCode());
            md5AigcBean.setNodeType(request.getNodeType());
            md5AigcBeanList.add(md5AigcBean);
        }
        // 排序
        List<PmpAigcBean> sortedList = md5AigcBeanList.stream().sorted(Comparator.comparing(PmpAigcBean::getDocId)).collect(Collectors.toList());
        String md5 = MD5Util.encrypt32(JSON.toJSONString(sortedList));
        request.setMd5(md5);
        String windCode = request.getDocBean().get(0).getWindCode();

        AiGcPreprocRequest preprocRequest = new AiGcPreprocRequest();
        preprocRequest.setMd5(request.getMd5());
        preprocRequest.setWindCode(windCode);
        preprocRequest.setNodeType(request.getNodeType());
        String answerMG = aiResearchService.getHangTreeText(preprocRequest);

        if (StringUtils.isNotBlank(answerMG)) {
            try {
                res.getWriter().write(DataUtils.simulateLineBreaks(answerMG) + "\n\n");
                res.getWriter().flush();
                res.getWriter().write("data:[DONE]" + "\n\n");
                res.getWriter().flush();
            } catch (Exception e) {
                log.info("AIGC缓存数据:{}", e.getMessage());
            }
        } else {
            StreamChatResponse streamChatResponse = aiResearchService.aiResearchAigc(request);
            StringBuilder answer = new StringBuilder();
            if (null != streamChatResponse) {
                try (okhttp3.Response response = streamChatResponse.getResponse()) {
                    String line;
                    while ((line = Objects.requireNonNull(response.body()).source().readUtf8Line()) != null) {
                        if (line.equals(END_SIGN_OF_ALICE) || line.contains("[DONE]")) {
                            res.getWriter().write(line + "\n\n");
                            res.getWriter().flush();
                            break;
                        } else if (line.startsWith(DATA_KEY)) {
                            String dataStr = line.substring(DATA_KEY.length()).trim();
                            JSONObject responseJson;
                            try {
                                responseJson = JSONObject.parseObject(dataStr);
                                JSONArray choicesArray = responseJson.getJSONArray("choices");
                                if (choicesArray != null && choicesArray.size() > 0) {
                                    String content = choicesArray.getJSONObject(0).getJSONObject("delta").getString("content");
                                    if (StrUtil.isNotEmpty(content)) {
                                        answer.append(content);
                                        res.getWriter().write(line + "\n\n");
                                        res.getWriter().flush();
                                    }
                                }
                            } catch (Exception e) {
                                log.error("alice response extract err, origin content: {} errMsg:{}", line, ExceptionUtils.stacktraceToString(e, 8));
                            }
                        }
                    }
                } catch (Exception e) {
                    log.error("输出异常{}", ExceptionUtils.stacktraceToString(e, 8));
                }

                List<DocListBean> docListBeanList = new ArrayList<>();
                if (request.getNodeType().equals(Constants.NodeType.ONE) || request.getNodeType().equals(Constants.NodeType.TWO)) {
                    //勾选的文档ID，过滤向量失败的文档ID
                    List<DocBean> paramsList = request.getDocBean();
                    for (int i = 0; i < paramsList.size(); i++) {
                        DocBean docBean = paramsList.get(i);
                        if (!docBean.isSubmitFlag() && request.getNodeType().equals(Constants.NodeType.ONE)) {
                            continue;
                        }
                        DocListBean docListBean = new DocListBean();
                        if (request.getNodeType().equals(Constants.NodeType.ONE)) {
                            docListBean.setFrameworkDocId(docBean.getDocId());
                            docListBean.setFrameworkDocName(docBean.getDocName());
                        } else if (request.getNodeType().equals(Constants.NodeType.TWO)) {
                            docListBean.setBreakdownDocId(docBean.getDocId());
                            docListBean.setBreakdownDocName(docBean.getDocName());
                        }
                        docListBeanList.add(docListBean);
                    }

                    //自有文档
                    if (request.isSelfDocFlg() && docListBeanList.size() > 0) {
                        //是否N+1 自有文档 固定值  P045503
                        DocListBean docListBean1 = new DocListBean();
                        String md5DocId = windCode + request.getCompanyName();
                        if (request.getNodeType().equals(Constants.NodeType.ONE)) {
                            docListBean1.setFrameworkDocId(MD5Util.encrypt32(md5DocId));
                            docListBean1.setFrameworkDocName(request.getCompanyName() + "-自有文档");
                        } else if (request.getNodeType().equals(Constants.NodeType.TWO)) {
                            docListBean1.setBreakdownDocId(MD5Util.encrypt32(md5DocId));
                            docListBean1.setBreakdownDocName(request.getCompanyName() + "-自有文档");
                        }
                        docListBeanList.add(docListBean1);
                    }
                }
                AiGcPreprocRequest saveRequest = new AiGcPreprocRequest();
                saveRequest.setWindCode(windCode);
                saveRequest.setNodeType(request.getNodeType());
                saveRequest.setPromptId(request.getPromptId());
                saveRequest.setText(answer.toString());
                saveRequest.setDocListBean(docListBeanList);
                saveRequest.setMd5(request.getMd5());
                aiResearchService.saveHangTree(saveRequest);
            } else {
                try {
                    res.getWriter().write("\t no data!");
                    res.getWriter().flush();
                } catch (Exception e) {
                    log.info("AIGC没返回数据:{}", e.getMessage());
                }
            }
        }

    }

