    /**
     * AI投研框架->列表选项AIGC 流输出
     *
     * @param request
     * @return
     */
    @PostMapping("/framework/qualityInspection")
    public void qualityInspection(@RequestBody QualityInspectionRequest request, HttpServletRequest req, HttpServletResponse res) {
        String sessionId = config.getProperty("data.summary.sessionId", "87b8217fe4cb4c36a51b68400662a2db");
        String userId = config.getProperty("data.summary.userId", "6938791");
        MDC.put(InjectVariable.USER_ID, userId);
        UserBean userBean = new UserBean();
        userBean.setUserId(Integer.parseInt(userId));
        userBean.setSessionId(sessionId);
        MdcInjectAspect.USER_BEAN_THREAD_LOCAL.set(userBean);
        InjectVariable.setQuestionType(QuestionTypeEnum.AI_FRAMEWORK_QUESTION.getQuestionType());
        log.info("AiResearchAigc: {}", request);

        String curOrigin = req.getHeader("Origin");
        res.setHeader("Access-Control-Allow-Origin", curOrigin == null ? "true" : curOrigin);
        res.setHeader("Access-Control-Allow-Credentials", "true");
        res.setHeader("Access-Control-Allow-Methods", "POST, GET, OPTIONS, DELETE, HEAD");
        res.setHeader("Access-Control-Max-Age", "3600");
        res.setHeader("Access-Control-Allow-Headers", "access-control-allow-origin, authority, content-type, version-info, X-Requested-With");
        res.setContentType("text/event-stream;charset=UTF-8");

        //请求报文唯一标识
        //给默认值
        request.setNodeType(StringUtils.isEmpty(request.getNodeType()) ? Constants.NodeType.ONE : request.getNodeType());

        StreamChatResponse streamChatResponse = aiResearchService.qualityInspection(request);
        StringBuilder answer = new StringBuilder();
        if (null != streamChatResponse) {
            try (okhttp3.Response response = streamChatResponse.getResponse()) {
                String line;
                while ((line = Objects.requireNonNull(response.body()).source().readUtf8Line()) != null) {
                    if (line.equals(END_SIGN_OF_ALICE) || line.contains("[DONE]")) {
                        res.getWriter().write(line + "\n\n");
                        res.getWriter().flush();
                        break;
                    } else if (line.startsWith(DATA_KEY)) {
                        String dataStr = line.substring(DATA_KEY.length()).trim();
                        JSONObject responseJson;
                        try {
                            responseJson = JSONObject.parseObject(dataStr);
                            JSONArray choicesArray = responseJson.getJSONArray("choices");
                            if (choicesArray != null && choicesArray.size() > 0) {
                                String content = choicesArray.getJSONObject(0).getJSONObject("delta").getString("content");
                                if (StrUtil.isNotEmpty(content)) {
                                    answer.append(content);
                                    res.getWriter().write(line + "\n\n");
                                    res.getWriter().flush();
                                }
                            }
                        } catch (Exception e) {
                            log.error("alice response extract err, origin content: {} errMsg:{}", line, ExceptionUtils.stacktraceToString(e, 8));
                        }
                    }
                }
            } catch (Exception e) {
                log.error("输出异常{}", ExceptionUtils.stacktraceToString(e, 8));
            }
        } else {
            try {
                res.getWriter().write("\t no data!");
                res.getWriter().flush();
            } catch (Exception e) {
                log.info("AIGC没返回数据:{}", e.getMessage());
            }
        }

    }

