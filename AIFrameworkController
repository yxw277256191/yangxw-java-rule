    /**
     * AI投研框架->聚合 AIGC
     *
     * @param request
     * @return
     */
    @BuryingLog(apiUrl = "/framework/hangTreeAigc")
    @PostMapping("/framework/hangTreeAigc")
    public void hangTreeAigc(@RequestBody AiHangTreeRequest request, HttpServletRequest req, HttpServletResponse res) {
        String sessionId = config.getProperty("data.framework.sessionId", "87b8217fe4cb4c36a51b68400662a2db");
        String userId = config.getProperty("data.framework.userId", "6938791");
        MDC.put(InjectVariable.USER_ID, userId);
        UserBean userBean = new UserBean();
        userBean.setUserId(Integer.parseInt(userId));
        userBean.setSessionId(sessionId);
        InjectVariable.setThreadLocal(userBean);
        String windCode = StringUtils.isEmpty(request.getWindCode()) ? "" : request.getWindCode();
        String companyName = StringUtils.isEmpty(request.getCompanyName()) ? "" : request.getCompanyName();
        MDC.put(Constants.TRACE_QUESTION, windCode + companyName + "聚合");
        InjectVariable.setQuestionType(QuestionTypeEnum.AI_FRAMEWORK_QUESTION.getQuestionType());
        log.info("hangTreeAigc: {}", request);
        String curOrigin = req.getHeader("Origin");
        res.setHeader("Access-Control-Allow-Origin", curOrigin == null ? "true" : curOrigin);
        res.setHeader("Access-Control-Allow-Credentials", "true");
        res.setHeader("Access-Control-Allow-Methods", "POST, GET, OPTIONS, DELETE, HEAD");
        res.setHeader("Access-Control-Max-Age", "3600");
        res.setHeader("Access-Control-Allow-Headers", "access-control-allow-origin, authority, content-type, version-info, X-Requested-With");
        res.setContentType("text/event-stream;charset=UTF-8");

        if (StringUtils.isNotBlank(request.getNodeType()) && request.getNodeType().equals(Constants.NodeType.THREE)) {
            StreamChatResponse streamChatResponse = aiResearchService.hangTreeAigc(request);
            log.info("AiResearchAigcList.streamChatResponse: {}", JSONObject.toJSON(streamChatResponse));
            StringBuilder answer = new StringBuilder();
            if (null != streamChatResponse) {
                log.info("实际选择的模型地址 getStreamInput: {}", streamChatResponse.getUrl());
                try (okhttp3.Response response = streamChatResponse.getResponse()) {
                    String line;
                    while ((line = Objects.requireNonNull(response.body()).source().readUtf8Line()) != null) {
                        if (line.equals(END_SIGN_OF_ALICE) || line.contains("[DONE]")) {
                            res.getWriter().write(line + "\n\n");
                            res.getWriter().flush();
                            break;
                        } else if (line.startsWith(DATA_KEY)) {
                            String dataStr = line.substring(DATA_KEY.length()).trim();
                            JSONObject responseJson;
                            try {
                                responseJson = JSONObject.parseObject(dataStr);
                                String content = responseJson
                                        .getJSONArray("choices")
                                        .getJSONObject(0)
                                        .getJSONObject("delta")
                                        .getString("content");
                                if (StrUtil.isNotEmpty(content)) {
                                    answer.append(content);
                                    res.getWriter().write(line + "\n\n");
                                    res.getWriter().flush();
                                }
                            } catch (Exception e) {
                                log.error("alice response extract err, origin content: {} errMsg:{}", line, ExceptionUtils.stacktraceToString(e, 8));
                            }
                        }
                    }
                } catch (Exception e) {
                    log.error("输出异常{}", ExceptionUtils.stacktraceToString(e, 8));
                }
                String answerNew = answer.toString();
                int end = answerNew.indexOf("</think>");
                if (end > 0) {
                    answerNew = answerNew.substring(end, answerNew.length()).replace("</think>", "");
                }
                log.info("answerNew:{}", answerNew);
                AiGcPreprocRequest preprocRequest = new AiGcPreprocRequest();
                preprocRequest.setWindCode(request.getWindCode());
                preprocRequest.setNodeType(request.getNodeType());
                preprocRequest.setPromptId(request.getPromptId());
                preprocRequest.setText(answerNew.toString());
                // 排序
                List<DocListBean> sortedList = request.getDocListBean().stream().filter(bean -> bean.getFrameworkDocId() != null).sorted(Comparator.comparing(DocListBean::getFrameworkDocId)).collect(Collectors.toList());
                String md5 = MD5Util.encrypt32(JSON.toJSONString(sortedList));
                preprocRequest.setMd5(md5);
                aiResearchService.saveHangTree(preprocRequest);
            } else {
                try {
                    res.getWriter().write("\n\t no data!");
                    res.getWriter().flush();
                } catch (Exception e) {
                    log.info("AIGC没返回数据:{}", e.getMessage());
                }
            }

        } else {
            try {
                res.getWriter().write("\n\t no data!");
                res.getWriter().flush();
            } catch (Exception e) {
                log.info("AIGC没返回数据:{}", e.getMessage());
            }
        }
    }


