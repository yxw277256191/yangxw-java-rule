                                if (choicesArray != null && choicesArray.size() > 0) {
                                    String content = choicesArray.getJSONObject(0).getJSONObject("delta").getString("content");
                                    if (StrUtil.isNotEmpty(content)) {
                                        answer.append(content);
                                        res.getWriter().write(line + "\n\n");
                                        res.getWriter().flush();
                                    }
                                }
                            } catch (Exception e) {
                                log.error("alice response extract err, origin content: {} errMsg:{}", line, ExceptionUtils.stacktraceToString(e, 8));
                            }
                        }
                    }
                } catch (Exception e) {
                    log.error("输出异常{}", ExceptionUtils.stacktraceToString(e, 8));
                }

                log.info("answer:{}", answer);
                List<DocListBean> docListBeanList = new ArrayList<>();
                if (request.getNodeType().equals(Constants.NodeType.ONE) || request.getNodeType().equals(Constants.NodeType.TWO)) {
                    //勾选的文档ID，过滤向量失败的文档ID
                    List<DocBean> paramsList = request.getDocBean();
                    for (int i = 0; i < paramsList.size(); i++) {
                        DocBean docBean = paramsList.get(i);
                        if (!docBean.isSubmitFlag() && request.getNodeType().equals(Constants.NodeType.ONE)) {
                            continue;
                        }
                        DocListBean docListBean = new DocListBean();
                        if (request.getNodeType().equals(Constants.NodeType.ONE)) {
                            docListBean.setFrameworkDocId(docBean.getDocId());
                            docListBean.setFrameworkDocName(docBean.getDocName());
                        } else if (request.getNodeType().equals(Constants.NodeType.TWO)) {
                            docListBean.setBreakdownDocId(docBean.getDocId());
                            docListBean.setBreakdownDocName(docBean.getDocName());
                        }
                        docListBeanList.add(docListBean);
                    }

                    //自有文档
                    if (request.isSelfDocFlg() && docListBeanList.size() > 0) {
                        //是否N+1 自有文档 固定值  P045503
                        DocListBean docListBean1 = new DocListBean();
                        String md5DocId = windCode + request.getCompanyName();
                        if (request.getNodeType().equals(Constants.NodeType.ONE)) {
                            docListBean1.setFrameworkDocId(MD5Util.encrypt32(md5DocId));
                            docListBean1.setFrameworkDocName(request.getCompanyName() + "-自有文档");
                        } else if (request.getNodeType().equals(Constants.NodeType.TWO)) {
                            docListBean1.setBreakdownDocId(MD5Util.encrypt32(md5DocId));
                            docListBean1.setBreakdownDocName(request.getCompanyName() + "-自有文档");
                        }
                        docListBeanList.add(docListBean1);
                    }
                }
                AiGcPreprocRequest saveRequest = new AiGcPreprocRequest();
                saveRequest.setWindCode(windCode);
                saveRequest.setNodeType(request.getNodeType());
                saveRequest.setPromptId(request.getPromptId());
                saveRequest.setText(answer.toString());
                saveRequest.setDocListBean(docListBeanList);
                saveRequest.setMd5(request.getMd5());
                aiResearchService.saveHangTree(saveRequest);
            } else {
                try {
                    res.getWriter().write("\t no data!");
                    res.getWriter().flush();
                } catch (Exception e) {
                    log.info("AIGC没返回数据:{}", e.getMessage());
                }
            }
        }

    }

